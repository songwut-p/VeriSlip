# Copy this file to .env and fill in the values. Never commit .env.

# Required. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# Optional (default: false). Set to true ONLY when the app runs behind a trusted
# reverse proxy (e.g. Cloudflare) and the server cannot be reached directly;
# otherwise X-Forwarded-For can be forged to bypass the login rate limit.
# TRUST_PROXY_HEADERS=false
